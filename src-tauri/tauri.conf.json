{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kollab",
  "version": "0.6.16",
  "identifier": "app.kollab.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Kollab",
        "width": 1280,
        "height": 820,
        "minWidth": 380,
        "minHeight": 560,
        "backgroundColor": "#F5F6FA",
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Gestion de projet pour équipes de dev",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "11.0"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDkwQjNEREVDNUQzRDNCMDEKUldRQk96MWQ3TjJ6a0JMY0V5eGtWWGljWE13cGxDeFFWVVE3dmluSjBCRWlYYythQytVcWNGN1AK",
      "endpoints": [
        "https://github.com/ambroise-boutrin/kollab/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
